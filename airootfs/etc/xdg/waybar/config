{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 8,

  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "cpu",
    "memory"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "battery",
    "custom/power"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5,
    "tooltip": true
  },

  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },

  "network": {
    "format-wifi": "WiFi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format-wifi": "{essid}"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  
  "custom/power": {
      "format": "",
      "tooltip": true,
      "tooltip-format": "Power Menu",
      "on-click": "wlogout -p layer-shell"
  }

}