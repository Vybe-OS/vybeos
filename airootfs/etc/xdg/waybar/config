{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 8,

  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/logo"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "battery",
    "network",
    "custom/power"
  ],

  "custom/logo": {
    "format": "vOs",
    "tooltip": false
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5,
    "tooltip": true
  },

  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },

  "network": {
    "format-wifi": "WiFi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format-wifi": "{essid}"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Opsi Daya",
    "on-click": "sh -c 'if pgrep -x swaynag >/dev/null; then pkill -x swaynag; else swaynag -t warning -e bottom -y overlay --background 101a30 --text dde7ff --border b26cff --button-background 192743 --button-text dde7ff -m \"Opsi Daya\" -Z \"Keluar\" \"swaymsg exit\" -Z \"Mulai Ulang\" \"systemctl reboot\" -Z \"Matikan\" \"systemctl poweroff\" & fi'"
  }
}