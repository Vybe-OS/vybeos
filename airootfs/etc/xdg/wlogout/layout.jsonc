
[
    {
        "label": "lock",
        "action": "swaylock",
        "text": "Lock",
        "keybind": "l"
    },
    {
        "label": "shutdown",
        "action": "systemctl poweroff",
        "text": "Shutdown",
        "keybind": "s"
    },
    {
        "label": "reboot",
        "action": "systemctl reboot",
        "text": "Reboot",
        "keybind": "r"
    },
    {
        "label": "logout",
        "action": "swaymsg exit",
        "text": "Logout",
        "keybind": "e"
    }
]
